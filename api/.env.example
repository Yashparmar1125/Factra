# Factra Environment Configuration
# Place this file in the api/ directory or root directory

# 1. SERPER API KEY (Web Consensus Engine)
# Required for Pillar 2 (Real-time Google News consensus cross-referencing).
# Obtain from: https://serper.dev (Free tier available: 2,500 free queries)
SERPER_API_KEY=

# 2. GOOGLE FACT CHECK TOOLS API KEY (Optional)
# Used for real-time verification against published fact-checkers.
# Obtain from: https://console.cloud.google.com (Fact Check Tools API)
FACT_CHECK_API_KEY=

# 3. INTERNATIONALIZATION (i18n) SETTINGS
# Set to 1 to enable non-English auto-translation via Google Translator
I18N_ENABLE_TRANSLATION=1
# Set to 1 to return the translated English text in the API response JSON
I18N_RETURN_TRANSLATED_TEXT=0
